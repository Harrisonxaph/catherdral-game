{
  "name": "vesper-castle",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "python3 -m http.server 3000",
    "test": "node --test chapter.test.cjs enemy-system.test.cjs equipment.test.cjs character-state.test.cjs save-store.test.cjs area-identity.test.cjs campaign-state.test.cjs command-coordinator.test.cjs game-session.test.cjs abilities.test.cjs graphics.test.cjs boss-system.test.cjs boss-presentation.test.cjs vfx-state.test.cjs tests/graphics-budget.test.cjs",
    "test:browser": "node tests/browser.cjs",
    "test:inventory-browser": "node tests/inventory-browser.cjs",
    "test:abilities-browser": "node tests/abilities-browser.cjs",
    "test:graphics-browser": "node tests/graphics-browser.cjs",
    "test:effects-browser": "node tests/effects-browser.cjs",
    "test:hud-layout-browser": "node tests/hud-layout-browser.cjs",
    "capture:visuals": "node tests/visual-capture.cjs",
    "test:offline-browser": "node tests/offline-browser.cjs",
    "test:save-store-browser": "node tests/save-store-browser.cjs",
    "test:persistence-browser": "node tests/persistence-browser.cjs",
    "test:bosses-browser": "node tests/bosses-browser.cjs",
    "test:boss-art-browser": "node tests/boss-art-browser.cjs",
    "capture:bosses": "node tests/capture-bosses.cjs",
    "build": "node scripts/build.mjs",
    "capture:graphics-v2": "CAPTURE_SET=v2 node tests/visual-capture.cjs",
    "test:graphics-budget": "node tests/graphics-budget.cjs"
  },
  "packageManager": "npm@10.8.2"
}
